{
  "compilerOptions": {
    "target":           "ES2022",
    "module":           "ESNext",
    "moduleResolution": "Bundler",
    "lib":              ["ES2022"],
    "jsx":              "react-native",
    "strict":           true,
    "declaration":      true,
    "outDir":           "lib/typescript",
    "esModuleInterop":  true,
    "skipLibCheck":     true,
    "allowSyntheticDefaultImports": true,
    "types":            []
  },
  "include": ["src/**/*"]
}
